// =========================================================
//  Deux saisons de planche — schéma de base de données
//  Prisma + PostgreSQL
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  member
  admin
}

enum MembershipStatus {
  pending // paiement en attente / dossier incomplet
  active
  expired
}

enum DocumentType {
  medical_certificate // certificat médical
  insurance // attestation d'assurance
}

enum DocumentStatus {
  pending
  approved
  rejected
}

enum SpotType {
  street
  park
  bowl
}

enum RegistrationStatus {
  registered
  cancelled
  attended
}

enum TaskStatus {
  todo
  doing
  done
}

// ---------- Modèles ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(member)
  firstname    String
  lastname     String
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  registrations EventRegistration[]
  documents     Document[]
  tasks         Task[]

  @@map("users")
}

model Membership {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  status      MembershipStatus @default(pending)
  amountCents Int              @default(0)
  paymentId   String? // Stripe PaymentIntent id ou référence HelloAsso
  receiptUrl  String? // reçu d'adhésion (PDF)
  documentUrl String? // justificatif principal lié à l'adhésion (compat. cahier des charges)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@map("memberships")
}

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  date        DateTime
  endDate     DateTime?
  location    String
  description String
  imageUrl    String?
  capacity    Int?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registrations EventRegistration[]

  @@index([date])
  @@map("events")
}

model EventRegistration {
  id               String             @id @default(cuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           RegistrationStatus @default(registered)
  registrationDate DateTime           @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

model Document {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       DocumentType
  url        String
  filename   String
  status     DocumentStatus @default(pending)
  note       String? // motif de rejet / commentaire admin
  uploadedAt DateTime       @default(now())
  reviewedAt DateTime?

  @@index([userId])
  @@index([status])
  @@map("documents")
}

model Spot {
  id          String   @id @default(cuid())
  name        String
  address     String
  type        SpotType
  description String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("spots")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(todo)
  position    Int        @default(0) // ordre dans la colonne
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, position])
  @@map("tasks")
}

// ---------- Quiz ----------

model Quiz {
  id              String   @id @default(cuid())
  title           String
  description     String?
  imageUrl        String? // image d'en-tête du quiz (Vercel Blob en prod, /media/… en local)
  timePerQuestion Int? // minuterie en secondes par question ; null = pas de limite
  published       Boolean  @default(false) // un seul quiz publié à la fois, affiché sur /quiz
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@map("quizzes")
}

model QuizQuestion {
  id       String       @id @default(cuid())
  quizId   String
  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text     String
  imageUrl String? // image facultative affichée avec la question
  position Int          @default(0)
  answers  QuizAnswer[]

  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizAnswer {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  position   Int          @default(0)

  @@index([questionId])
  @@map("quiz_answers")
}

model QuizSubmission {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  name      String
  ipHash    String // HMAC de l'IP : une participation par IP et par quiz (contrainte unique)
  ip        String? // IP en clair, visible des admins (modération) ; absente des premières participations
  score     Int
  total     Int
  results   Json // [{ questionId, correct }] : statistiques par question
  createdAt DateTime @default(now())

  @@unique([quizId, ipHash])
  @@index([quizId, score])
  @@map("quiz_submissions")
}
