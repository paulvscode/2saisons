# =========================================================
#  Copier en .env (local) / renseigner dans Vercel (prod)
# =========================================================

# ---- Base de données ----
# Local (Docker) :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deux_saisons?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/deux_saisons?schema=public"
# Prod (Neon/Supabase) : DATABASE_URL = URL POOLÉE (…-pooler…, ?pgbouncer=true)
#                        DIRECT_URL   = URL DIRECTE (port 5432, sans -pooler) pour les migrations

# ---- Auth ----
# openssl rand -base64 32
AUTH_SECRET="change-me-32-bytes-minimum-secret"
# Local : http://localhost:3000  —  Prod : https://votre-domaine.fr
APP_URL="http://localhost:3000"

# ---- Paiement (Stripe) ----
# Laisser vide => l'adhésion est validée directement (mode démo, sans paiement réel).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Alternative HelloAsso
# HELLOASSO_CLIENT_ID=""
# HELLOASSO_CLIENT_SECRET=""
# HELLOASSO_ORG_SLUG=""

# ---- Stockage des justificatifs ----
# "local" => ./uploads (dev uniquement — disque éphémère sur Vercel)
# "blob"  => Vercel Blob (prod) — créer un store Blob et laisser Vercel injecter le token
UPLOADS_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# ---- Cotisation ----
MEMBERSHIP_PRICE_CENTS="2000"       # 20,00 €
MEMBERSHIP_DURATION_MONTHS="12"
